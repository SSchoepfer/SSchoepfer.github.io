source "https://rubygems.org"
gemspec

# Plugins declared in _config.yml (`gems:` key, used by GitHub Pages)
gem "jekyll-sitemap"
gem "jekyll-seo-tag"

# Standard-library gems that were removed as defaults in Ruby 3.4+.
# Jekyll 3.8 and its dependencies still `require` these, so they must be
# declared explicitly or the build fails with LoadError.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "erb"
gem "ostruct"
gem "logger"
gem "rexml"
gem "webrick" # needed by `jekyll serve` on Ruby 3.0+
